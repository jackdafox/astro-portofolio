---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Data
const education = [
  {
    period: "2021–2025",
    title: "Bachelor of Multimedia Computing",
    description: `Universiti Malaya, Malaysia`,
    location: "CGPA: 3.59",
  },
];
---

<section>
  <Wrapper variant="base" class="py-12">
    <Text
      tag="h3"
      variant="displayLG"
      class="font-semibold text-zinc-900 dark:text-zinc-200"
    >
      Education
    </Text>

    <div class="flex flex-col gap-12 mt-5 lg:mt-8">
      {
        education.map((education, index) => (
          <div class="grid grid-cols-1  gap-4 md:grid-cols-2 lg:grid-cols-5">
            {/* Period */}
            <Text tag="span" variant="textSM" class="font-medium text-zinc-500">
              {education.period}
            </Text>

            {/* Work Content */}
            <div class="lg:col-span-4">
              <Text
                tag="h4"
                variant="textBase"
                class="font-semibold text-zinc-900 dark:text-zinc-200  flex justify-between w-full"
              >
                {education.title}
              </Text>
              <Text
                tag="p"
                variant="textSM"
                class="text-zinc-600 dark:text-zinc-500  mt-2"
              >
                {education.description}
              </Text>
              <Text
                tag="p"
                variant="textSM"
                class="text-zinc-600 dark:text-zinc-500  mt-2"
              >
                {education.location}
              </Text>
            </div>
          </div>
        ))
      }
    </div>
  </Wrapper>
</section>
